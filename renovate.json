{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "group:allNonMajor",
    "group:allDigest",
    ":disableDependencyDashboard"
  ],
  "prCreation": "not-pending",
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "pinDigests": true,
  "nix": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true,
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo dependencies",
      "commitMessageTopic": "Cargo dependencies"
    },
    {
      "description": "Keep libc on a minor-only requirement",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["libc"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Expedite cargo security updates \u2014 bypass weekly schedule",
      "matchManagers": ["cargo"],
      "matchCategories": ["security"],
      "schedule": ["at any time"],
      "automerge": true,
      "labels": ["security"],
      "groupName": "cargo security updates",
      "commitMessageTopic": "Cargo security updates"
    },
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Disable known-incompatible crate updates",
      "matchPackageNames": [
        "libp2p-stream",
        "parameterized",
        "cipher",
        "chacha20",
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Keep hopr-api on the 2.0.x patch line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-api"],
      "allowedVersions": "/^2\\.0\\./"
    },
    {
      "description": "Keep hopr-types on the 2.3.x patch line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-types"],
      "allowedVersions": "/^2\\.3\\./"
    },
    {
      "description": "Keep libp2p on the 0.56.x patch line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["libp2p"],
      "allowedVersions": "/^0\\.56\\./"
    },
    {
      "description": "Keep hopr-utilities on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-utilities"],
      "allowedVersions": "/^0\\.9\\./"
    },
    {
      "description": "Keep hopr-chain-connector on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-chain-connector"],
      "allowedVersions": "/^0\\.22\\./"
    },
    {
      "description": "Keep hopr-ticket-manager on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-ticket-manager"],
      "allowedVersions": "/^0\\.5\\./"
    },
    {
      "description": "Keep hopr-session-server-forwarder on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-session-server-forwarder"],
      "allowedVersions": "/^0\\.1\\./"
    },
    {
      "description": "Keep hopr-transport-p2p on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-transport-p2p"],
      "allowedVersions": "/^0\\.9\\./"
    },
    {
      "description": "Keep hopr-ct-full-network on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-ct-full-network"],
      "allowedVersions": "/^0\\.4\\./"
    },
    {
      "description": "Keep hopr-network-graph on the compat/v4 line",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["hopr-network-graph"],
      "allowedVersions": "/^0\\.5\\./"
    }
  ]
}
